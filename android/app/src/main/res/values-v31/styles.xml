<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/tea_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_steam3</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/tea_cream</item>
        <item name="android:windowBackground">@color/tea_cream</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/tea_cream</item>
        <item name="android:navigationBarColor">@color/tea_cream</item>
        <item name="android:statusBarColor">@color/tea_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
